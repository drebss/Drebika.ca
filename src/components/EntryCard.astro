---
import type { CollectionEntry } from "astro:content";

interface Props { entry: CollectionEntry<"entries">; }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="card" href={`/archive/${entry.id}`}>
  {d.cover && (<div class="card-media"><img src={d.cover} alt="" loading="lazy" /></div>)}
  <div class="card-title"><span>{d.title}</span><span class="meta">{d.year}</span></div>
  <p class="card-summary">{d.summary}</p>
  <p class="meta">{d.type} · {d.status}</p>
</a>
