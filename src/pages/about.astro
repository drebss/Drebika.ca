---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing about page");
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description}>
  <header class="entry-head"><p class="eyebrow">About</p><h1>Ahmed Drebika</h1></header>
  <article class="entry-body"><Content /></article>
</BaseLayout>
