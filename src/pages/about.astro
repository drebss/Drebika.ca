---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteLinks } from "../data/site";

const page = await getEntry("pages", "about");
if (!page) throw new Error("Missing about page");
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} description={page.data.description} nav="info">
  <div class="about-page">
    <div class="about-layout">
      <header class="about-head">
        <div class="about-lead entry-body">
          <Content />
        </div>
        <p class="about-contact">
          <a href={`mailto:${siteLinks.email}`}>Get in touch.</a>
        </p>
      </header>

      <figure class="about-media">
        <img
          class="about-media__image"
          src="/media/about/portrait.png"
          alt="Ahmed Drebika"
          width={2080}
          height={2078}
          loading="eager"
        />
      </figure>
    </div>
  </div>
</BaseLayout>
