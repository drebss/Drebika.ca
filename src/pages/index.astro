---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("entries", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const objects = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  summary: entry.data.summary,
  type: entry.data.type,
  status: entry.data.status,
  year: entry.data.year,
  cover: entry.data.cover ?? "",
  related: entry.data.related,
}));

const initial = entries.find((entry) => entry.data.current) ?? entries.find((entry) => entry.data.featured) ?? entries[0];
---
<BaseLayout>
  <section class="relation-intro">
    <p>Ahmed Drebika is an artist and creative technologist based in Montreal.</p>
    <span>Select an object to move through the work.</span>
  </section>

  {initial && (
    <section class="object-field" data-initial={initial.id}>
      <svg class="branch-layer" aria-hidden="true"></svg>
      <div class="focus-object" data-focus>
        <a class="focus-image" href={`/archive/${initial.id}`} data-focus-link>
          {initial.data.cover && <img src={initial.data.cover} alt="" data-focus-image />}
        </a>
        <div class="focus-caption">
          <p class="object-meta" data-focus-meta>{initial.data.year} · {initial.data.type}</p>
          <h1 data-focus-title>{initial.data.title}</h1>
          <p data-focus-summary>{initial.data.summary}</p>
          <a href={`/archive/${initial.id}`} data-focus-link-text>Open object →</a>
        </div>
      </div>
      <div class="related-objects" data-related></div>
    </section>
  )}

  <script type="application/json" id="object-data" set:html={JSON.stringify(objects)}></script>
  <script>
    const field = document.querySelector<HTMLElement>(".object-field");
    const dataNode = document.querySelector<HTMLScriptElement>("#object-data");
    if (field && dataNode) {
      const objects = JSON.parse(dataNode.textContent || "[]");
      const byId = new Map(objects.map((item) => [item.id, item]));
      const relatedHost = field.querySelector<HTMLElement>("[data-related]");
      const svg = field.querySelector<SVGSVGElement>(".branch-layer");
      const positions = [
        [12, 18], [76, 14], [84, 58], [61, 78], [17, 72], [6, 46]
      ];

      const drawLines = () => {
        if (!svg) return;
        svg.innerHTML = "";
        const focus = field.querySelector<HTMLElement>("[data-focus]");
        if (!focus) return;
        const fieldRect = field.getBoundingClientRect();
        const focusRect = focus.getBoundingClientRect();
        const x1 = focusRect.left + focusRect.width / 2 - fieldRect.left;
        const y1 = focusRect.top + focusRect.height / 2 - fieldRect.top;
        field.querySelectorAll<HTMLElement>(".related-object").forEach((node) => {
          const r = node.getBoundingClientRect();
          const x2 = r.left + r.width / 2 - fieldRect.left;
          const y2 = r.top + r.height / 2 - fieldRect.top;
          const line = document.createElementNS("http://www.w3.org/2000/svg", "path");
          const mx = (x1 + x2) / 2;
          line.setAttribute("d", `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`);
          svg.appendChild(line);
        });
      };

      const render = (id) => {
        const item = byId.get(id);
        if (!item || !relatedHost) return;
        const title = field.querySelector<HTMLElement>("[data-focus-title]");
        const summary = field.querySelector<HTMLElement>("[data-focus-summary]");
        const meta = field.querySelector<HTMLElement>("[data-focus-meta]");
        const image = field.querySelector<HTMLImageElement>("[data-focus-image]");
        const imageLink = field.querySelector<HTMLAnchorElement>("[data-focus-link]");
        const textLink = field.querySelector<HTMLAnchorElement>("[data-focus-link-text]");
        if (title) title.textContent = item.title;
        if (summary) summary.textContent = item.summary;
        if (meta) meta.textContent = `${item.year} · ${item.type}`;
        if (image) { image.src = item.cover; image.hidden = !item.cover; }
        if (imageLink) imageLink.href = `/archive/${item.id}`;
        if (textLink) textLink.href = `/archive/${item.id}`;

        const explicit = item.related.map((rid) => byId.get(rid)).filter(Boolean);
        const fallback = objects.filter((candidate) => candidate.id !== item.id).slice(0, 6);
        const related = (explicit.length ? explicit : fallback).slice(0, 6);
        relatedHost.innerHTML = "";
        related.forEach((relatedItem, index) => {
          const button = document.createElement("button");
          button.className = "related-object";
          button.style.setProperty("--x", `${positions[index][0]}%`);
          button.style.setProperty("--y", `${positions[index][1]}%`);
          button.innerHTML = `${relatedItem.cover ? `<img src="${relatedItem.cover}" alt="">` : ""}<span>${relatedItem.title}</span><small>${relatedItem.year} · ${relatedItem.type}</small>`;
          button.addEventListener("click", () => render(relatedItem.id));
          relatedHost.appendChild(button);
        });
        requestAnimationFrame(drawLines);
      };

      render(field.dataset.initial || objects[0]?.id);
      window.addEventListener("resize", drawLines);
    }
  </script>
</BaseLayout>
