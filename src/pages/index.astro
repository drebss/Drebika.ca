---
import BaseLayout from "../layouts/BaseLayout.astro";
import { branchScrollItems, dialPayload, dialProjects, dialTree } from "../data/navigation";
import "../styles/home.css";
---
<BaseLayout nav="orbit">
  <div class="radial-home" data-radial-menu tabindex="0">
    <aside class="radial-stage" data-radial-stage aria-label="Navigation">
      <nav class="radial-mobile" data-mobile-nav aria-label="Projects">
        <div class="radial-mobile__categories" role="tablist" aria-label="Categories">
          {
            dialTree.map((category, mainIdx) => (
              <button
                type="button"
                class="radial-mobile__category"
                role="tab"
                data-mobile-category
                data-main-idx={mainIdx}
                aria-selected={mainIdx === 0 ? "true" : "false"}
              >
                {category.title}
              </button>
            ))
          }
        </div>
        {
          dialTree.map((category, mainIdx) => (
            <ul
              class="radial-mobile__group"
              data-mobile-group
              data-main-idx={mainIdx}
              hidden={mainIdx !== 0}
            >
              {(category.children ?? []).map((project, projectIdx) => (
                <li>
                  <button
                    type="button"
                    class="radial-mobile__project"
                    data-mobile-project
                    data-main-idx={mainIdx}
                    data-project-idx={projectIdx}
                    data-project-id={project.id}
                  >
                    <span class="radial-mobile__project-title">{project.title}</span>
                    <span class="radial-mobile__project-sub">{project.subtitle}</span>
                  </button>
                </li>
              ))}
            </ul>
          ))
        }
      </nav>
      <div class="radial-nav-scroll" data-nav-scroll aria-hidden="true">
        <div class="radial-nav-scroll__inner">
          {
            branchScrollItems.map((item, index) => {
              const prev = index > 0 ? branchScrollItems[index - 1] : null;
              const showGap = prev !== null && prev.mainIdx !== item.mainIdx;
              return (
                <>
                  {showGap && <div class="radial-nav-snap radial-nav-snap--gap" />}
                  <div
                    class="radial-nav-snap"
                    data-project-key={`${item.mainIdx}:${item.projectIdx}`}
                    data-visual-index={item.visualIndex}
                    data-project-id={item.id}
                  />
                </>
              );
            })
          }
        </div>
      </div>
      <div class="radial-track" data-radial-track></div>
    </aside>

    <div class="radial-preview" data-radial-preview>
      <div class="radial-preview__scroll" data-preview-scroll>
        {
          dialProjects.map((project) => (
            <article
              class="radial-project"
              data-project-key={`${project.mainIdx}:${project.projectIdx}`}
              data-project-id={project.id}
            >
              <div class="radial-project__layout">
                <header class="radial-project__head">
                  <p class="radial-project__eyebrow">{project.categoryTitle}</p>
                  <h2 class="radial-project__title radial-project__title--mobile">{project.title}</h2>
                  <p class="radial-project__subtitle radial-project__subtitle--mobile">{project.subtitle}</p>
                  {project.descriptionHtml ? (
                    <p class="radial-project__body" set:html={project.descriptionHtml} />
                  ) : (
                    <p class="radial-project__body">{project.description}</p>
                  )}
                  {project.tags.length > 0 && (
                    <ul class="radial-project__tags">
                      {project.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  {project.infoHref && (
                    <a class="radial-project__info" href={project.infoHref}>
                      Project info
                    </a>
                  )}
                  {project.slides && project.slides.length > 1 && (
                    <p class="radial-project__count" data-project-count>
                      {project.slides.length} items
                    </p>
                  )}
                </header>

                <div class="radial-project__media" data-project-gallery>
                  {project.slides?.map((slide, slideIdx) => (
                    <figure
                      class="radial-project__figure"
                      data-slide-index={slideIdx}
                    >
                      {slide.kind === "video" ? (
                        <video
                          class="radial-project__video"
                          src={slide.src}
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          data-autoplay-video
                        />
                      ) : (
                        <img
                          class="radial-project__image"
                          src={slide.src}
                          alt={slide.title ?? project.title}
                          loading="lazy"
                        />
                      )}
                    </figure>
                  ))}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <script type="application/json" data-radial-data set:html={JSON.stringify(dialPayload)}></script>
  </div>

  <script>
    import "../scripts/radial-menu.ts";
  </script>
</BaseLayout>
