---
import "../styles/global.css";
import "../styles/relations.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ahmed Drebika",
  description = "Artist and creative technologist working across interfaces, spatial media, artificial intelligence and image-making.",
} = Astro.props;

const pageTitle = title === "Ahmed Drebika" ? title : `${title} — Ahmed Drebika`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" aria-label="Ahmed Drebika home">Ahmed Drebika</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/archive">Archive</a>
        <a href="/about">About</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Ahmed Drebika</span>
      <span>Montreal, Canada</span>
      <a href="mailto:hello@drebika.ca">hello@drebika.ca</a>
    </footer>
  </body>
</html>
