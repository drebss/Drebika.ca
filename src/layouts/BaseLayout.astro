---
import "../styles/fonts.css";
import "../styles/global.css";
import { siteLinks } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  nav?: "home" | "grid" | "info";
}

const {
  title = "Ahmed Drebika",
  description = "Artist and creative technologist working across interfaces, spatial media, artificial intelligence and image-making.",
  nav,
} = Astro.props;

const pageTitle = title === "Ahmed Drebika" ? title : `${title} — Ahmed Drebika`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-logo" aria-label="Ahmed Drebika home">Ahmed Drebika</a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" class:list={[{ "is-active": nav === "home" }]}>Home</a>
        <a href="/grid" class:list={[{ "is-active": nav === "grid" }]}>Grid</a>
        <a href="/about" class:list={[{ "is-active": nav === "info" }]}>Info</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p class="site-footer__year">{year}</p>
      <nav class="site-footer__links" aria-label="Contact">
        <a href={siteLinks.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={`mailto:${siteLinks.email}`}>Mail</a>
      </nav>
    </footer>
  </body>
</html>
